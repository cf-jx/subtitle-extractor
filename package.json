{
  "name": "subtitle-extractor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "package:macos": "bash scripts/package-macos.sh",
    "package:macos:dmg": "bash scripts/create-macos-dmg.sh",
    "package:macos:repair": "bash scripts/repair-macos-app-signature.sh",
    "runtime:fetch": "node scripts/fetch-runtime.mjs",
    "runtime:ffmpeg": "bash scripts/build-ffmpeg.sh",
    "runtime:ffmpeg:windows": "bash scripts/build-ffmpeg-windows.sh",
    "runtime:verify:windows": "node scripts/verify-windows-runtime.mjs",
    "runtime:verify:windows:installers": "pwsh -NoProfile -File scripts/verify-windows-installers.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
